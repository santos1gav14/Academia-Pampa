rules_version = '2';

// =============================================================================
// Regras de segurança do Firestore — Academia do Pampa
//
// COMO APLICAR
// 1. No Console do Firebase, abra seu projeto > Firestore Database > Regras.
// 2. Cole o conteúdo deste arquivo por cima do que estiver lá e publique.
//    (Ou, se preferir a CLI: `firebase deploy --only firestore:rules`,
//    com este arquivo referenciado em firebase.json.)
//
// BOOTSTRAP DO PRIMEIRO ADMIN (leia antes de publicar)
// Com estas regras, todo autocadastro nasce com status "pendente" e
// isAdmin=false — de propósito, para que ninguém consiga virar admin só
// forjando a chamada ao Firestore pelo console do navegador. Isso significa
// que, quando não existe NENHUM admin ainda, ninguém consegue aprovar
// ninguém pelo app. Para o primeiríssimo admin do sistema:
//   1. Peça para essa pessoa se cadastrar normalmente pelo app (vai ficar
//      "Cadastro em análise").
//   2. No Console do Firebase, vá em Firestore Database > Dados >
//      coleção "usuarios" > documento com o SARAM dela.
//   3. Edite os campos manualmente: status = "aprovado", isAdmin = true.
// Depois disso, essa pessoa já consegue aprovar os demais e conceder admin
// a outras pessoas direto pelo app.
//
// ATENÇÃO — MIGRAÇÃO OBRIGATÓRIA ANTES DE PUBLICAR ESTA VERSÃO
// A partir desta versão, as reservas de turno moraram de um array "lista"
// dentro do documento do turno para uma subcoleção "reservas" (um documento
// por pessoa) — é o que permite a regra abaixo impedir que alguém edite a
// reserva de outra pessoa. Se você já tem reservas reais no ar no formato
// antigo, rode migrations/migrar-reservas-subcolecao.js ANTES de publicar
// estas regras e o novo index.html, senão essas reservas somem da tela
// (o campo antigo "lista" continua no banco, só o app novo não lê mais
// dele). Veja o cabeçalho daquele script para o passo a passo.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function mySaram() {
      return request.auth.token.email.split('@')[0];
    }
    function myUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(mySaram()));
    }
    function isApproved() {
      return isSignedIn() && myUserDoc().data.status == 'aprovado';
    }
    function isAdmin() {
      return isSignedIn() && myUserDoc().data.isAdmin == true && myUserDoc().data.status == 'aprovado';
    }

    // ---- usuarios/{saram} ----
    // Qualquer pessoa logada pode ler a lista (é o roster do esquadrão, já
    // aparece nas reservas de turno); só o próprio dono pode CRIAR seu
    // cadastro inicial (sempre pendente/sem privilégios); só admin edita
    // status, posto, nome, telefone, isAdmin e isPiloto de qualquer um.
    match /usuarios/{saram} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && saram == mySaram()
        && request.resource.data.saram == saram
        && request.resource.data.status == 'pendente'
        && request.resource.data.isAdmin == false
        && request.resource.data.isPiloto == false;
      allow create: if isAdmin(); // admin cadastrando outra pessoa direto já aprovada
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- reservas_academia/{dateKey_turno} ----
    // O documento "pai" de cada turno não guarda mais nenhuma contagem —
    // o app checa a capacidade direto na subcoleção "reservas" dentro da
    // própria transação (tx.get de uma query), então esse documento pai
    // nem precisa existir. Só é lido (nunca escrito) por segurança.
    match /reservas_academia/{turnoId} {
      allow read: if isApproved();

      // ---- reservas_academia/{dateKey_turno}/reservas/{saram} ----
      // Uma reserva = um documento, dono é quem tem o SARAM do ID do
      // documento. Ninguém pode editar uma reserva já existente (update
      // sempre falso) e só o dono ou um admin cancela (apaga) — isso é
      // o que impede alguém de adulterar a reserva de outra pessoa.
      //
      // A criação é uma exceção pensada: além do próprio dono se
      // reservar, quando alguém cancela e existe fila de espera, o app
      // promove automaticamente o primeiro elegível — criando a reserva
      // dele dentro da MESMA transação de quem cancelou, não da pessoa
      // promovida. Por isso `create` aqui não exige saram==mySaram().
      // O trade-off aceito: um usuário aprovado poderia, forçando a mão,
      // criar uma reserva "em nome" de outra pessoa sem passar pela fila.
      // Não é escalada de privilégio nem acesso a dado sensível (o roster
      // já é público entre aprovados) e é facilmente corrigível por um
      // admin apagando a reserva indevida — por isso ficou assim em vez
      // de travar mais (o que exigiria Cloud Functions, que esse projeto
      // não usa hoje).
      match /reservas/{saram} {
        allow read: if isApproved();
        allow create: if isApproved() && request.resource.data.saram == saram;
        allow delete: if isApproved() && (saram == mySaram() || isAdmin());
        allow update: if false;
      }

      // ---- reservas_academia/{dateKey_turno}/fila/{saram} ----
      // Fila de espera: aqui sim, só o próprio dono entra na fila (você
      // não pode colocar outra pessoa na fila por ela). Sair da fila é
      // você mesmo ou um admin. A promoção (criar a reserva de quem
      // estava na fila) acontece na regra de "reservas" acima, não aqui.
      match /fila/{saram} {
        allow read: if isApproved();
        allow create: if isApproved()
          && saram == mySaram()
          && request.resource.data.saram == saram;
        allow delete: if isApproved() && (saram == mySaram() || isAdmin());
        allow update: if false;
      }
    }

    // ---- historico/{saram_dateKey_turno} ----
    // Cada usuário só lê o próprio histórico; admin lê o de qualquer um.
    // create/update ficam abertos a qualquer aprovado (mesmo trade-off do
    // "reservas" acima: quando alguém é promovido da fila de espera, é
    // quem cancelou que grava o histórico da pessoa promovida — não ela
    // mesma). É só um registro informativo, não controla acesso a nada.
    match /historico/{docId} {
      allow read: if isApproved() && (resource.data.saram == mySaram() || isAdmin());
      allow create, update: if isApproved();
      allow delete: if isAdmin();
    }

    // ---- avisos/{id} ----
    match /avisos/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // ---- avisos_lidos/{saram_avisoId} ----
    // Cada usuário só marca ciência em nome de si mesmo.
    match /avisos_lidos/{id} {
      allow read: if isApproved() && resource.data.saram == mySaram();
      allow create, update: if isApproved() && request.resource.data.saram == mySaram();
    }

    // ---- notificacoes/{id} ----
    // Cada usuário só lê e marca como lida a própria notificação. Criar é
    // liberado a qualquer aprovado, porque quem gera a notificação (ex:
    // "você foi promovido da fila") é sempre outra pessoa (quem cancelou
    // a reserva), não a destinatária.
    match /notificacoes/{id} {
      allow read: if isApproved() && resource.data.saram == mySaram();
      allow create: if isApproved();
      allow update: if isApproved() && resource.data.saram == mySaram();
    }

    // ---- financas/{id} (prestação de contas) ----
    // Leitura é visível para todo aprovado (transparência financeira);
    // só admin lança receita/despesa.
    match /financas/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // ---- pagamentos/{saram_mesKey} ----
    // Cada usuário lê o próprio status de pagamento; admin lê e edita o de
    // todo mundo (tela de controle de pagamentos).
    match /pagamentos/{id} {
      allow read: if isApproved() && (resource.data.saram == mySaram() || isAdmin());
      allow create, update: if isAdmin();
    }

    // ---- config/pix, config/vagas ----
    // Leitura liberada para todo aprovado (chave Pix para pagar mensalidade,
    // capacidade de vagas para calcular disponibilidade); só admin edita.
    match /config/{id} {
      allow read: if isApproved();
      allow create, update: if isAdmin();
    }
  }
}
